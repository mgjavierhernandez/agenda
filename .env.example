# ============================================================
# AGENDA ESCOLAR DIGITAL - Variables de entorno (EJEMPLO)
# Copiar este archivo a `.env` en la raiz del repositorio y
# ajustar los valores. NUNCA commitear el archivo `.env`.
#
# Los valores aqui son SOLO PARA DESARROLLO LOCAL.
# En produccion, usar AWS Secrets Manager / Parameter Store.
# ============================================================

# --- Aplicacion ---
NODE_ENV=development
PORT=3000

# Origenes permitidos para CORS (separados por coma).
# Para desarrollo web de Vite:
CORS_ORIGIN=http://localhost:5173

# --- Base de datos (PostgreSQL) ---
# Conexion del backend (Prisma). Coincide con los valores del docker-compose.
DATABASE_URL=postgresql://agenda:agenda_dev_password@localhost:5432/agenda_dev?schema=public

# --- PostgreSQL (Docker Compose local) ---
POSTGRES_USER=agenda
POSTGRES_PASSWORD=agenda_dev_password
POSTGRES_DB=agenda_dev
POSTGRES_PORT=5432