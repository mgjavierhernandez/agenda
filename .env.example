# ============================================================
# AGENDA ESCOLAR DIGITAL - Variables de entorno (EJEMPLO)
# Copiar este archivo a `.env` en la raiz del repositorio y
# ajustar los valores. NUNCA commitear el archivo `.env`.
#
# Los valores aqui son SOLO PARA DESARROLLO LOCAL.
# En produccion, usar AWS Secrets Manager / Parameter Store.
# ============================================================

# --- Aplicacion ---
NODE_ENV=development
PORT=3000

# Origenes permitidos para CORS (separados por coma).
# En development, si no se establece, solo se permite http://localhost:5173.
# En production, DEBE configurarse explicitamente con los dominios reales.
# Ejemplo: CORS_ORIGIN=https://app.example.com,https://admin.example.com
CORS_ORIGIN=http://localhost:5173

# --- Base de datos (PostgreSQL) ---
# Conexion del backend (Prisma). Coincide con los valores del docker-compose.
DATABASE_URL=postgresql://agenda:agenda_dev_password@localhost:5432/agenda_dev?schema=public

# --- PostgreSQL (Docker Compose local) ---
POSTGRES_USER=agenda
POSTGRES_PASSWORD=agenda_dev_password
POSTGRES_DB=agenda_dev
POSTGRES_PORT=5432

# --- JWT Authentication ---
# ⚠️ PRODUCCION: Usar secreto generado criptograficamente (min 256 bits).
# Generar con: openssl rand -base64 32
# Nunca commitear el valor real de JWT_ACCESS_SECRET.
JWT_ACCESS_SECRET=dev-only-jwt-access-secret-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Password Reset ---
PASSWORD_RESET_TOKEN_EXPIRES_MINUTES=60

# --- Rate Limiting ---
# TTL en segundos para la ventana de rate limiting global.
RATE_LIMIT_TTL=60
# Numero maximo de requests por ventana por IP (global: 50, auth: 10).
RATE_LIMIT_LIMIT=50

# --- Google OAuth (opcional) ---
# Si no se configuran, los endpoints /auth/google responden 503 y el login
# email/password sigue funcionando. Ver docs/112-self-registration-approval.md
# para la guía de configuración en Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# --- File Storage ---
FILE_STORAGE_PROVIDER=local
FILE_STORAGE_PATH=./storage
FILE_MAX_SIZE_MB=10
MAX_TASK_ATTACHMENTS=10
MAX_COMMUNICATION_ATTACHMENTS=10
