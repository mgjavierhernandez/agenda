{
  "name": "agenda-escolar-digital",
  "version": "1.0.1",
  "private": true,
  "description": "Agenda Escolar Digital - Plataforma SaaS multi-institucion de gestion y comunicacion escolar",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@agenda/web",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format": "npm run format --workspaces --if-present",
    "format:check": "npm run format:check --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npx playwright test",
    "test:e2e:ui": "npx playwright test --ui",
    "test:e2e:headed": "npx playwright test --headed",
    "test:e2e:report": "npx playwright show-report",
    "dev:api": "npm run start:dev --workspace @agenda/api",
    "dev:web": "npm run dev --workspace @agenda/web",
    "db:up": "docker compose --env-file .env -f infra/docker/docker-compose.yml up -d",
    "db:down": "docker compose --env-file .env -f infra/docker/docker-compose.yml down",
    "prisma:generate": "npm run prisma:generate --workspace @agenda/api",
    "prisma:migrate": "npm run prisma:migrate --workspace @agenda/api",
    "prisma:studio": "npm run prisma:studio --workspace @agenda/api"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.40.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@types/multer": "^2.2.0",
    "axe-core": "^4.13.0"
  }
}
