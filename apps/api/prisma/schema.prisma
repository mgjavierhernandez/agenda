  @@index([institutionId, status])
  @@index([institutionId, teacherUserId])
  @@index([institutionId, classroomId])
  @@index([institutionId, blockId])
  @@index([institutionId, academicPeriodId])
  @@map("schedules")
}

// ============================================================
