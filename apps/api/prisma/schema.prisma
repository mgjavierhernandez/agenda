  institutionId String   @map("institution_id") @db.Uuid
  followUpId    String   @map("follow_up_id") @db.Uuid
  fileAssetId   String   @map("file_asset_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")

  institution Institution     @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  followUp    StudentFollowUp @relation(fields: [followUpId], references: [id], onDelete: Restrict)
  fileAsset   FileAsset       @relation(fields: [fileAssetId], references: [id], onDelete: Restrict)

  @@unique([followUpId, fileAssetId])
  @@index([institutionId])
  @@index([institutionId, followUpId])
  @@index([followUpId])
  @@index([fileAssetId])
  @@map("follow_up_attachments")
}

// ============================================================
// FOLLOW-UP CITATION (Scheduling of meetings/citations within a follow-up)
// ============================================================

model FollowUpCitation {
  id            String                 @id @default(uuid()) @db.Uuid
  institutionId String                 @map("institution_id") @db.Uuid
  followUpId    String                 @map("follow_up_id") @db.Uuid
  createdById   String                 @map("created_by_id") @db.Uuid
  scheduledAt   DateTime               @map("scheduled_at")
  reason        String                 @db.VarChar(500)
  objective     String?                @db.Text
  status        FollowUpCitationStatus @default(SCHEDULED)
  result        String?                @db.Text
  attendedAt    DateTime?              @map("attended_at")
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @updatedAt @map("updated_at")

  institution Institution     @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  followUp    StudentFollowUp @relation(fields: [followUpId], references: [id], onDelete: Restrict)
  createdBy   User            @relation("FollowUpCitationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([institutionId])
  @@index([followUpId])
  @@index([followUpId, status])
  @@index([institutionId, scheduledAt])
  @@index([createdById])
  @@map("follow_up_citations")
}

// ============================================================
// FOLLOW-UP CATEGORY (Institution-scoped categories)
// ============================================================

model FollowUpCategory {
  id            String   @id @default(uuid()) @db.Uuid
  institutionId String   @map("institution_id") @db.Uuid
  name          String   @db.VarChar(100)
  description   String?  @db.Text
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  institution Institution       @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  followUps   StudentFollowUp[]

  @@unique([institutionId, name])
  @@index([institutionId])
  @@index([institutionId, active])
  @@map("follow_up_categories")
}

// ============================================================
// TASK ATTACHMENT (Links files to tasks)
// ============================================================

model TaskAttachment {
  id            String   @id @default(uuid()) @db.Uuid
  institutionId String   @map("institution_id") @db.Uuid
  taskId        String   @map("task_id") @db.Uuid
  fileAssetId   String   @map("file_asset_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  task        Task        @relation(fields: [taskId], references: [id], onDelete: Restrict)
  fileAsset   FileAsset   @relation(fields: [fileAssetId], references: [id], onDelete: Restrict)

  @@unique([taskId, fileAssetId])
  @@index([institutionId])
  @@index([institutionId, taskId])
  @@index([taskId])
  @@index([fileAssetId])
  @@map("task_attachments")
}

// ============================================================
// COMMUNICATION ATTACHMENT (Links files to communications)
// ============================================================

model CommunicationAttachment {
  id              String   @id @default(uuid()) @db.Uuid
  institutionId   String   @map("institution_id") @db.Uuid
  communicationId String   @map("communication_id") @db.Uuid
  fileAssetId     String   @map("file_asset_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  institution   Institution   @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  communication Communication @relation(fields: [communicationId], references: [id], onDelete: Restrict)
  fileAsset     FileAsset     @relation(fields: [fileAssetId], references: [id], onDelete: Restrict)

  @@unique([communicationId, fileAssetId])
  @@index([institutionId])
  @@index([institutionId, communicationId])
  @@index([communicationId])
  @@index([fileAssetId])
  @@map("communication_attachments")
}

// ============================================================
// AGENDA EVENT (Custom calendar events created by staff)
// ============================================================

model AgendaEvent {
  id            String                @id @default(uuid()) @db.Uuid
  institutionId String                @map("institution_id") @db.Uuid
  createdById   String                @map("created_by_id") @db.Uuid
  title         String                @db.VarChar(200)
  description   String?               @db.Text
  startAt       DateTime              @map("start_at")
  endAt         DateTime              @map("end_at")
  location      String?               @db.VarChar(255)
  audience      CommunicationAudience @default(ALL)
  status        AgendaEventStatus     @default(ACTIVE)
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  createdBy   User        @relation("AgendaEventCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([institutionId])
  @@index([institutionId, status])
  @@index([institutionId, startAt])
  @@index([institutionId, audience])
  @@index([institutionId, createdById])
  @@map("agenda_events")
}
