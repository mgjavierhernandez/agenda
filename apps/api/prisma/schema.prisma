generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum InstitutionStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum MembershipStatus {
  PENDING
  ACTIVE
  INACTIVE
  SUSPENDED
  REJECTED
}

enum RoleType {
  GLOBAL
  TEMPLATE
  TENANT
}

enum StudentStatus {
  ACTIVE
  INACTIVE
}

enum CourseStatus {
  ACTIVE
  INACTIVE
}

enum SubjectStatus {
  ACTIVE
  INACTIVE
}

enum GradeStatus {
  ACTIVE
  INACTIVE
}

enum ScheduleStatus {
  ACTIVE
  INACTIVE
}

enum EducationLevel {
  PREESCOLAR
  PRIMARIA
  SECUNDARIA
  MEDIA
}

enum SubjectType {
  OBLIGATORIA
  OPTATIVA
  PROFUNDIZACION
  TRANSVERSAL
  DIMENSION
}

enum ClassroomType {
  AULA
  LAB_FISICA
  LAB_QUIMICA
  COMPUTO
  CANCHA
  AUDITORIO
}

enum TaskStatus {
  DRAFT
  PUBLISHED
  CLOSED
  INACTIVE
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum DocumentType {
  DNI
  PASSPORT
  NATIONAL_ID
  OTHER
}

enum CommunicationAudience {
  ALL
  TEACHERS
  PARENTS
  STUDENTS
}

enum AgendaEventStatus {
  ACTIVE
  CANCELLED
}

enum CommunicationStatus {
  DRAFT
  PUBLISHED
  INACTIVE
}

enum SignatureRequestStatus {
  DRAFT
  PUBLISHED
  COMPLETED
  EXPIRED
  INACTIVE
}

enum SignatureRecipientStatus {
  PENDING
  SIGNED
  DECLINED
}

enum NotificationType {
  SIGNATURE_REQUEST
  SIGNATURE_COMPLETED
  SIGNATURE_DECLINED
  COMMUNICATION
  TASK_UPDATE
  GENERAL
  STUDENT_FOLLOW_UP
  COMMITMENT_UPDATE
}

enum NotificationStatus {
  UNREAD
  READ
}

enum SchoolGradeStatus {
  ACTIVE
  INACTIVE
}

enum AcademicPeriodStatus {
  ACTIVE
  INACTIVE
  CLOSED
}

enum RelationshipType {
  FATHER
  MOTHER
  LEGAL_GUARDIAN
  OTHER
}

enum GuardianStudentStatus {
  ACTIVE
  INACTIVE
}

enum EnrollmentStatus {
  ACTIVE
  INACTIVE
  WITHDRAWN
}

enum TeacherAssignmentStatus {
  ACTIVE
  INACTIVE
}

enum CourseDirectorStatus {
  ACTIVE
  INACTIVE
}

enum TaskAssignmentStatus {
  ASSIGNED
  COMPLETED
  CANCELLED
}

enum TaskSubmissionStatus {
  PENDING
  SUBMITTED
  LATE
  GRADED
  RETURNED
}

enum CommunicationRecipientStatus {
  DELIVERED
  READ
}

enum FileAssetStatus {
  ACTIVE
  DELETED
}

enum FollowUpType {
  ACADEMICO
  CONVIVENCIA
  FORMATIVO
}

enum FollowUpSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum FollowUpStatus {
  OPEN
  IN_PROGRESS
  ESCALATED
  PENDING_FOLLOW_UP
  RESOLVED
  CLOSED
}

enum FollowUpConfidentiality {
  PUBLIC
  INTERNAL
  CONFIDENTIAL
  SENSITIVE
}

enum FollowUpEntryType {
  NOTE
  MEETING
  OBSERVATION
  ACTION
  FOLLOW_UP
}

enum CommitmentStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
  OVERDUE
}

enum CommitmentResponsibleRole {
  ADMIN
  TEACHER
  PARENT
  STUDENT
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum FollowUpCitationStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

// ============================================================
// STUDENT FOLLOW-UP (Observador del Alumno)
// ============================================================

model StudentFollowUp {
  id              String                  @id @default(uuid()) @db.Uuid
  institutionId   String                  @map("institution_id") @db.Uuid
  studentId       String                  @map("student_id") @db.Uuid
  categoryId      String?                 @map("category_id") @db.Uuid
  createdById     String                  @map("created_by_id") @db.Uuid
  type            FollowUpType
  severity        FollowUpSeverity        @default(MEDIUM)
  status          FollowUpStatus          @default(OPEN)
  confidentiality FollowUpConfidentiality @default(INTERNAL)
  title           String                  @db.VarChar(200)
  summary         String?                 @db.Text
  description     String?                 @db.Text
  closedAt        DateTime?               @map("closed_at")
  closedById      String?                 @map("closed_by_id") @db.Uuid
  createdAt       DateTime                @default(now()) @map("created_at")
  updatedAt       DateTime                @updatedAt @map("updated_at")

  institution       Institution          @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  student           Student              @relation(fields: [studentId], references: [id], onDelete: Restrict)
  category          FollowUpCategory?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdBy         User                 @relation("FollowUpCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  closedBy          User?                @relation("FollowUpClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  entries           FollowUpEntry[]
  commitments       Commitment[]
  attachments       FollowUpAttachment[]
  citations         FollowUpCitation[]
  signatureRequests SignatureRequest[]

  @@index([institutionId])
  @@index([institutionId, studentId])
  @@index([institutionId, status])
  @@index([institutionId, type])
  @@index([institutionId, confidentiality])
  @@index([institutionId, categoryId])
  @@index([institutionId, createdById])
  @@index([institutionId, createdAt])
  @@index([studentId])
  @@map("student_follow_ups")
}

// ============================================================
// FOLLOW-UP ENTRY (Timeline entry for a follow-up)
// ============================================================

model FollowUpEntry {
  id          String            @id @default(uuid()) @db.Uuid
  followUpId  String            @map("follow_up_id") @db.Uuid
  createdById String            @map("created_by_id") @db.Uuid
  entryType   FollowUpEntryType @map("entry_type")
  content     String            @db.Text
  createdAt   DateTime          @default(now()) @map("created_at")

  followUp          StudentFollowUp    @relation(fields: [followUpId], references: [id], onDelete: Restrict)
  createdBy         User               @relation(fields: [createdById], references: [id], onDelete: Restrict)
  signatureRequests SignatureRequest[]

  @@index([followUpId])
  @@index([followUpId, createdAt])
  @@index([createdById])
  @@map("follow_up_entries")
}

// ============================================================
// COMMITMENT (Agreement derived from a follow-up)
// ============================================================

model Commitment {
  id                String                    @id @default(uuid()) @db.Uuid
  followUpId        String                    @map("follow_up_id") @db.Uuid
  responsibleUserId String                    @map("responsible_user_id") @db.Uuid
  responsibleRole   CommitmentResponsibleRole @map("responsible_role")
  description       String                    @db.Text
  status            CommitmentStatus          @default(PENDING)
  dueDate           DateTime?                 @map("due_date")
  completedAt       DateTime?                 @map("completed_at")
  createdAt         DateTime                  @default(now()) @map("created_at")
  updatedAt         DateTime                  @updatedAt @map("updated_at")

  followUp        StudentFollowUp @relation(fields: [followUpId], references: [id], onDelete: Restrict)
  responsibleUser User            @relation(fields: [responsibleUserId], references: [id], onDelete: Restrict)

  @@index([followUpId])
  @@index([responsibleUserId])
  @@index([followUpId, status])
  @@index([followUpId, dueDate])
  @@map("commitments")
}

// ============================================================
// INSTITUTION (Tenant)
// ============================================================

model Institution {
  id        String            @id @default(uuid()) @db.Uuid
  name      String            @db.VarChar(255)
  slug      String            @unique @db.VarChar(100)
  status    InstitutionStatus @default(ACTIVE)
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  memberships              UserInstitution[]
  roles                    Role[]
  userRoles                UserRole[]
  userProfiles             UserProfile[]
  auditLogs                AuditLog[]
  students                 Student[]
  courses                  Course[]
  subjects                 Subject[]
  grades                   Grade[]
  schedules                Schedule[]
  tasks                    Task[]
  communications           Communication[]
  signatureRequests        SignatureRequest[]
  notifications            Notification[]
  schoolGrades             SchoolGrade[]
  academicPeriods          AcademicPeriod[]
  enrollments              Enrollment[]
  teacherAssignments       TeacherAssignment[]
  guardianStudents         GuardianStudent[]
  taskAssignments          TaskAssignment[]
  taskSubmissions          TaskSubmission[]
  communicationRecipients  CommunicationRecipient[]
  fileAssets               FileAsset[]
  taskAttachments          TaskAttachment[]
  communicationAttachments CommunicationAttachment[]
  studentFollowUps         StudentFollowUp[]
  followUpCategories       FollowUpCategory[]
  followUpAttachments      FollowUpAttachment[]
  followUpCitations        FollowUpCitation[]
  attendances              Attendance[]
  agendaEvents             AgendaEvent[]
  areas                    Area[]
  classrooms               Classroom[]
  scheduleBlocks           ScheduleBlock[]
  courseDirectorAssignments CourseDirectorAssignment[]

  @@map("institutions")
}

// ============================================================
// USER (Platform-level identity)
// ============================================================

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique @db.VarChar(255)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  firstName    String     @map("first_name") @db.VarChar(100)
  lastName     String     @map("last_name") @db.VarChar(100)
  googleId     String?    @unique @map("google_id") @db.VarChar(100)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  memberships              UserInstitution[]
  globalRoles              GlobalUserRole[]
  auditLogs                AuditLog[]
  refreshTokens            RefreshToken[]
  passwordResetTokens      PasswordResetToken[]
  signatureRecipients      SignatureRecipient[]
  notifications            Notification[]
  teacherAssignments       TeacherAssignment[]
  guardianStudents         GuardianStudent[]
  communicationRecipients  CommunicationRecipient[]
  uploadedFiles            FileAsset[]
  student                  Student?
  academicPeriodsCreated   AcademicPeriod[]         @relation("AcademicPeriodCreatedBy")
  academicPeriodsClosed    AcademicPeriod[]         @relation("AcademicPeriodClosedBy")
  createdFollowUps         StudentFollowUp[]        @relation("FollowUpCreatedBy")
  closedFollowUps          StudentFollowUp[]        @relation("FollowUpClosedBy")
  followUpEntries          FollowUpEntry[]
  commitments              Commitment[]
  recordedAttendances      Attendance[]             @relation("AttendanceRecordedBy")
  agendaEventsCreated      AgendaEvent[]            @relation("AgendaEventCreatedBy")
  signatureRequestsCreated SignatureRequest[]       @relation("SignatureRequestCreatedBy")
  followUpCitations        FollowUpCitation[]       @relation("FollowUpCitationCreatedBy")
  teachingSchedules        Schedule[]               @relation("ScheduleTeacher")
  courseDirectorAssignments CourseDirectorAssignment[] @relation("CourseDirectorAssignmentDirector")
  profiles                  UserProfile[]

  @@map("users")
}

// ============================================================
// USER PROFILE (Tenant-scoped personal/professional profile)
// ============================================================

model UserProfile {
  id             String        @id @default(uuid()) @db.Uuid
  userId         String        @map("user_id") @db.Uuid
  institutionId  String        @map("institution_id") @db.Uuid
  documentType   DocumentType? @map("document_type")
  documentNumber String?       @map("document_number") @db.VarChar(50)
  phone          String?       @db.VarChar(50)
  address        String?       @db.VarChar(255)
  birthDate      DateTime?     @map("birth_date") @db.Date
  profession     String?       @db.VarChar(150)
  bio            String?       @db.Text
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@unique([userId, institutionId])
  @@unique([institutionId, documentType, documentNumber])
  @@index([institutionId])
  @@map("user_profiles")
}

// ============================================================
// USER <-> INSTITUTION (Membership)
// ============================================================

model UserInstitution {
  id            String           @id @default(uuid()) @db.Uuid
  userId        String           @map("user_id") @db.Uuid
  institutionId String           @map("institution_id") @db.Uuid
  status        MembershipStatus @default(ACTIVE)
  requestedRole String?          @map("requested_role") @db.VarChar(50)
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  roles       UserRole[]

  @@unique([userId, institutionId])
  @@unique([id, institutionId])
  @@index([institutionId])
  @@map("user_institutions")
}

// ============================================================
// ROLE
// ============================================================

model Role {
  id            String   @id @default(uuid()) @db.Uuid
  name          String   @db.VarChar(50)
  description   String?  @db.Text
  isSystem      Boolean  @default(false) @map("is_system")
  roleType      RoleType @default(TENANT) @map("role_type")
  institutionId String?  @map("institution_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")

  institution Institution?     @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  userRoles   UserRole[]
  globalRoles GlobalUserRole[]

  @@unique([name, institutionId])
  @@unique([id, institutionId])
  @@index([institutionId])
  @@index([roleType])
  @@map("roles")
}

// ============================================================
// PERMISSION (Global definitions)
// ============================================================

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(100)
  module      String   @db.VarChar(50)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  roles RolePermission[]

  @@index([module])
  @@map("permissions")
}

// ============================================================
// ROLE <-> PERMISSION (Many-to-Many)
// ============================================================

model RolePermission {
  id           String @id @default(uuid()) @db.Uuid
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

// ============================================================
// USER <-> ROLE (Tenant-scoped, via UserInstitution)
// ============================================================

model UserRole {
  id                String   @id @default(uuid()) @db.Uuid
  userInstitutionId String   @map("user_institution_id") @db.Uuid
  roleId            String   @map("role_id") @db.Uuid
  institutionId     String   @map("institution_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")

  userInstitution UserInstitution @relation(fields: [userInstitutionId], references: [id], onDelete: Cascade)
  role            Role            @relation(fields: [roleId], references: [id], onDelete: Cascade)
  institution     Institution     @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@unique([userInstitutionId, roleId])
  @@index([roleId])
  @@index([institutionId])
  @@map("user_roles")
}

// ============================================================
// GLOBAL USER <-> ROLE (Platform-level, e.g. Super Admin)
// ============================================================

model GlobalUserRole {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([roleId])
  @@map("global_user_roles")
}

// ============================================================
// AUDIT LOG
// ============================================================

model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String?  @map("user_id") @db.Uuid
  institutionId String?  @map("institution_id") @db.Uuid
  action        String   @db.VarChar(100)
  entityType    String   @map("entity_type") @db.VarChar(50)
  entityId      String?  @map("entity_id") @db.Uuid
  oldValues     Json?    @map("old_values")
  newValues     Json?    @map("new_values")
  ipAddress     String?  @map("ip_address") @db.VarChar(45)
  createdAt     DateTime @default(now()) @map("created_at")

  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  institution Institution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([institutionId])
  @@index([institutionId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ============================================================
// REFRESH TOKEN (Persisted, revocable)
// ============================================================

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  revokedAt DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tokenHash])
  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

// ============================================================
// PASSWORD RESET TOKEN (One-time, time-limited)
// ============================================================

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([tokenHash])
  @@index([userId])
  @@index([tokenHash])
  @@index([userId, usedAt])
  @@map("password_reset_tokens")
}

// ============================================================
// STUDENT (Tenant-scoped academic resource)
// ============================================================

model Student {
  id             String        @id @default(uuid()) @db.Uuid
  institutionId  String        @map("institution_id") @db.Uuid
  userId         String?       @unique @map("user_id") @db.Uuid
  firstName      String        @map("first_name") @db.VarChar(100)
  lastName       String        @map("last_name") @db.VarChar(100)
  documentType   DocumentType  @map("document_type")
  documentNumber String        @map("document_number") @db.VarChar(50)
  dateOfBirth    DateTime?     @map("date_of_birth") @db.Date
  status         StudentStatus @default(ACTIVE)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  institution      Institution       @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  user             User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  grades           Grade[]
  enrollments      Enrollment[]
  guardianStudents GuardianStudent[]
  taskAssignments  TaskAssignment[]
  taskSubmissions  TaskSubmission[]
  studentFollowUps StudentFollowUp[]
  attendances      Attendance[]

  @@unique([institutionId, documentType, documentNumber])
  @@index([institutionId])
  @@index([institutionId, status])
  @@index([userId])
  @@map("students")
}

// ============================================================
// COURSE (Tenant-scoped academic resource)
// ============================================================

model Course {
  id            String         @id @default(uuid()) @db.Uuid
  institutionId String         @map("institution_id") @db.Uuid
  code          String         @db.VarChar(50)
  name          String         @db.VarChar(150)
  description   String?        @db.Text
  level         EducationLevel @default(PRIMARIA)
  schoolGradeId String?        @map("school_grade_id") @db.Uuid
  section       String?        @db.VarChar(10)
  status        CourseStatus   @default(ACTIVE)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  institution        Institution         @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  schoolGrade        SchoolGrade?        @relation(fields: [schoolGradeId], references: [id], onDelete: SetNull)
  grades             Grade[]
  schedules          Schedule[]
  tasks              Task[]
  enrollments        Enrollment[]
  teacherAssignments        TeacherAssignment[]
  attendances               Attendance[]
  courseDirectorAssignments CourseDirectorAssignment[]

  @@unique([institutionId, code])
  @@index([institutionId])
  @@index([institutionId, status])
  @@index([institutionId, schoolGradeId])
  @@map("courses")
}

// ============================================================
// SUBJECT (Tenant-scoped academic resource)
// ============================================================

model Subject {
  id                    String          @id @default(uuid()) @db.Uuid
  institutionId         String          @map("institution_id") @db.Uuid
  areaId                String?         @map("area_id") @db.Uuid
  code                  String          @db.VarChar(50)
  name                  String          @db.VarChar(150)
  description           String?         @db.Text
  subjectType           SubjectType     @default(OBLIGATORIA)
  minimumLevel          EducationLevel? @map("minimum_level")
  maximumLevel          EducationLevel? @map("maximum_level")
  isOptionalForStudent  Boolean         @default(false) @map("is_optional_for_student")
  intensityHoursPerWeek Int             @default(0) @map("intensity_hours_per_week")
  isPreescolarDimension Boolean         @default(false) @map("is_preescolar_dimension")
  transversalGuideline  String?         @map("transversal_guideline") @db.VarChar(100)
  status                SubjectStatus   @default(ACTIVE)
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")

  institution        Institution         @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  area               Area?               @relation(fields: [areaId], references: [id], onDelete: SetNull)
  grades             Grade[]
  schedules          Schedule[]
  tasks              Task[]
  teacherAssignments TeacherAssignment[]

  @@unique([institutionId, code])
  @@index([institutionId])
  @@index([institutionId, status])
  @@index([institutionId, areaId])
  @@map("subjects")
}

// ============================================================
// GRADE (Tenant-scoped academic resource)
// ============================================================

model Grade {
  id               String      @id @default(uuid()) @db.Uuid
  institutionId    String      @map("institution_id") @db.Uuid
  studentId        String      @map("student_id") @db.Uuid
  courseId         String      @map("course_id") @db.Uuid
  subjectId        String      @map("subject_id") @db.Uuid
  academicPeriodId String?     @map("academic_period_id") @db.Uuid
  value            Decimal     @db.Decimal(5, 2)
  period           String      @db.VarChar(50)
  evaluationType   String?     @map("evaluation_type") @db.VarChar(50)
  description      String?     @db.Text
  status           GradeStatus @default(ACTIVE)
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  institution    Institution     @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  student        Student         @relation(fields: [studentId], references: [id], onDelete: Restrict)
  course         Course          @relation(fields: [courseId], references: [id], onDelete: Restrict)
  subject        Subject         @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  academicPeriod AcademicPeriod? @relation(fields: [academicPeriodId], references: [id], onDelete: Restrict)

  @@index([institutionId])
  @@index([institutionId, studentId])
  @@index([institutionId, courseId])
  @@index([institutionId, subjectId])
  @@index([institutionId, status])
  @@index([institutionId, academicPeriodId])
  @@map("grades")
}

// ============================================================
// AREA (Hierarchical grouping of subjects, e.g. 9 obligatory MEN areas)
// ============================================================

model Area {
  id            String        @id @default(uuid()) @db.Uuid
  institutionId String        @map("institution_id") @db.Uuid
  code          String        @db.VarChar(50)
  name          String        @db.VarChar(150)
