# ============================================================
# AGENDA ESCOLAR DIGITAL (Backend API) - Variables de entorno
# Copiar a apps/api/.env y ajustar valores.
# En staging/produccion, usar gestor de secretos externo.
# ============================================================

# --- Aplicacion ---
NODE_ENV=development
PORT=3000

# --- CORS ---
# Origenes permitidos separados por coma.
# En development: http://localhost:5173
# En production: dominio real de la app
CORS_ORIGIN=http://localhost:5173

# --- Base de datos (PostgreSQL) ---
DATABASE_URL=postgresql://agenda:agenda_dev_password@localhost:5432/agenda_dev?schema=public

# --- JWT Authentication ---
# ⚠️ PRODUCCION: Usar secreto generado criptograficamente (min 256 bits).
# Generar con: openssl rand -base64 32
JWT_ACCESS_SECRET=change-me-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Password Reset ---
PASSWORD_RESET_TOKEN_EXPIRES_MINUTES=60

# --- Rate Limiting ---
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=50

# --- Email (SMTP) ---
# Real email is enabled only when SMTP_HOST is set to a non-empty value.
# Without SMTP_HOST the API falls back to a development stub that logs emails
# (never actually sends). SMTP credentials are never committed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@localhost
SMTP_SECURE=false

# --- Web App ---
# Base URL of the web frontend, used to build links inside emails.
APP_WEB_URL=http://localhost:5173

# --- File Storage ---
FILE_STORAGE_PROVIDER=local
FILE_STORAGE_PATH=./storage
FILE_MAX_SIZE_MB=10
MAX_TASK_ATTACHMENTS=10
MAX_COMMUNICATION_ATTACHMENTS=10
